        <mxCell id="m-mgr-h" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#18202b;fontStyle=1;" value="manager.py — lifecycle orchestration" vertex="1">
          <mxGeometry height="18" width="590" x="76" y="616" as="geometry" />
        </mxCell>
        <mxCell id="m-mgr-b" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#3d4a58;" value="create / pause / resume / respawn / kill, plus peek, steer, attach-ticket and share. Sequences worktree, branch, tmux and container side effects; kill is the only verb that deletes a branch. Placement (worktree or repo root) gates every worktree side effect." vertex="1">
