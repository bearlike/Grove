          <mxGeometry height="18" width="290" x="716" y="616" as="geometry" />
        </mxCell>
        <mxCell id="m-cfg-b" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#3d4a58;" value="Lowest first: built-in agent seed → user → committed project → project-local → declared env var → GROVE_*__* env → CLI. Frozen Pydantic. The `defaults` section alone inverts, user-first, field by field." vertex="1">
          <mxGeometry height="78" width="290" x="716" y="636" as="geometry" />
        </mxCell>
