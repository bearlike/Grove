        <mxCell id="c-client-h" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#18202b;fontStyle=1;" value="Client SDK  ·  src/grove/client/" vertex="1">
