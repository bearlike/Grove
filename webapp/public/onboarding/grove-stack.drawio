        </mxCell>
        <mxCell id="se6-b" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="Remote session HTTP; detached local spawns." vertex="1">
          <mxGeometry height="36" width="170" x="1154" y="890" as="geometry" />
        </mxCell>
        <mxCell id="note-flow" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f9f4e8;strokeColor=#e6d6ac;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="64" width="1280" x="60" y="944" as="geometry" />
        </mxCell>
        <mxCell id="note-flow-t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#5c4a1f;" value="Dependencies flow inward: orchestration imports utilities, never the reverse, and the MCP server may not import engine internals at all — which is what lets it run on a different host. The consequence of the in-process clients is that the daemon is NOT the only writer: a CLI verb and the TUI mutate state.json concurrently with it, and that is why every store holds a sidecar lock across its whole read-modify-write rather than relying on atomic publication alone." vertex="1">
          <mxGeometry height="48" width="1250" x="76" y="954" as="geometry" />
        </mxCell>
        <mxCell id="lane4" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#dfe5ec;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="238" width="1320" x="40" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="lane4-t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#8a97a6;fontStyle=1;" value="4  RUNTIME — where an agent actually runs" vertex="1">
          <mxGeometry height="18" width="500" x="60" y="1054" as="geometry" />
        </mxCell>
        <mxCell id="r-host" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#eef1f4;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="180" width="630" x="60" y="1082" as="geometry" />
        </mxCell>
        <mxCell id="r-host-h" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#18202b;fontStyle=1;" value="Host runtime" vertex="1">
          <mxGeometry height="18" width="600" x="76" y="1094" as="geometry" />
        </mxCell>
        <mxCell id="r-host-b" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#3d4a58;" value="One workspace = one git worktree + one tmux session. The agent binary runs in a pane inside it." vertex="1">
          <mxGeometry height="36" width="600" x="76" y="1114" as="geometry" />
        </mxCell>
        <mxCell id="r-host-1" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="100" width="190" x="76" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="r-host-1t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="git worktree&#xa;&#xa;${repo}/.worktrees/&lt;slug&gt;-&lt;ts&gt;, or the repo root itself for a ROOT-placement workspace." vertex="1">
          <mxGeometry height="86" width="162" x="90" y="1162" as="geometry" />
        </mxCell>
        <mxCell id="r-host-2" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="100" width="190" x="280" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="r-host-2t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="tmux session&#xa;&#xa;One pane per window. Its #{window_activity} is the ACTIVE-vs-IDLE source of truth." vertex="1">
          <mxGeometry height="80" width="162" x="294" y="1162" as="geometry" />
        </mxCell>
        <mxCell id="r-host-3" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="100" width="206" x="484" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="r-host-3t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="agent process&#xa;&#xa;Claude Code, Codex, Mewbo or a plain shell. Hooks post back to the daemon." vertex="1">
          <mxGeometry height="80" width="178" x="498" y="1162" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#eef1f4;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="188" width="630" x="710" y="1082" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr-h" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#18202b;fontStyle=1;" value="Container runtime  ·  the differentiator" vertex="1">
          <mxGeometry height="18" width="600" x="726" y="1094" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr-b" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#3d4a58;" value="Provisioned through @devcontainers/cli from the repo&#39;s committed .devcontainer/. tmux runs INSIDE the container." vertex="1">
          <mxGeometry height="36" width="600" x="726" y="1114" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr-1" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="110" width="190" x="726" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr-1t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="mounts&#xa;&#xa;The worktree, plus the git common dir at the SAME absolute path. Control files cross as individual :ro binds, never their directory." vertex="1">
          <mxGeometry height="110" width="167" x="736" y="1154" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr-2" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="100" width="190" x="930" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr-2t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="egress firewall&#xa;&#xa;An allowlist in DOCKER-USER, not just OUTPUT, so a nested docker run cannot route around it." vertex="1">
          <mxGeometry height="90" width="162" x="944" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr-3" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="100" width="206" x="1134" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="r-ctr-3t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="agent config dir&#xa;&#xa;Per-workspace, host-side, so a container&#39;s transcripts outlive its worktree." vertex="1">
          <mxGeometry height="90" width="178" x="1148" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="lane5" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#dfe5ec;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="1160" width="480" x="1380" y="160" as="geometry" />
        </mxCell>
        <mxCell id="lane5-t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#8a97a6;fontStyle=1;" value="5  DATA STORES — who owns what" vertex="1">
          <mxGeometry height="18" width="400" x="1400" y="174" as="geometry" />
        </mxCell>
        <mxCell id="d-grp1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#a34c27;fontStyle=1;" value="MACHINE STATE — ~/.local/state/grove/" vertex="1">
          <mxGeometry height="16" width="440" x="1400" y="204" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f2f5f9;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="196" width="440" x="1400" y="226" as="geometry" />
        </mxCell>
        <mxCell id="d1-t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="state.json — THE workspace registry. Every record for every repo on the host. Daemon, CLI and TUI all write it concurrently, so the whole read-modify-write is held under a lock on a SIDECAR file and published by rename.&#xa;&#xa;share-policies.json — per-project share TTL + passcode hashes.&#xa;handovers.json — issue-ops handover log, never evicted.&#xa;session-turns.json — turn counts keyed by transcript fingerprint.&#xa;quota-state.json — cross-process quota ledger. Merged, not replaced, so a narrow CLI run cannot delete the daemon&#39;s rows.&#xa;agent-sidecars/ — per-session hook push status.&#xa;logs/, agent-config/, container-*/ — per-workspace artifacts." vertex="1">
          <mxGeometry height="184" width="412" x="1414" y="238" as="geometry" />
        </mxCell>
        <mxCell id="d-grp2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#a34c27;fontStyle=1;" value="SQLITE — one rebuildable, one NOT" vertex="1">
          <mxGeometry height="16" width="440" x="1400" y="434" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f2f5f9;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="126" width="440" x="1400" y="456" as="geometry" />
        </mxCell>
        <mxCell id="d2-t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="usage-v&lt;N&gt;.sqlite3 — tokens, time, cost, quota, projected from the transcripts below. The schema version is IN THE FILENAME, so a bump orphans the old file rather than migrating it. Wholly derived; safe to delete.&#xa;&#xa;telemetry-exports.sqlite3 — which traces were already exported. NOT a cache: deleting it re-sends history.&#xa;usage-pricing.json — fetched model rates." vertex="1">
          <mxGeometry height="106" width="412" x="1414" y="468" as="geometry" />
        </mxCell>
        <mxCell id="d-grp3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#a34c27;fontStyle=1;" value="AGENT-OWNED — read, never written by Grove" vertex="1">
          <mxGeometry height="16" width="440" x="1400" y="594" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f2f5f9;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="146" width="440" x="1400" y="616" as="geometry" />
        </mxCell>
        <mxCell id="d3-t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="~/.claude/projects/&lt;cwd&gt;/&lt;uuid&gt;.jsonl and $CODEX_HOME/sessions/&lt;date&gt;/rollout-*.jsonl — the agents&#39; own transcripts, plus Codex&#39;s queue sqlite opened READ-ONLY. The source for status, todo, model and usage.&#xa;&#xa;The transcript cache is IN-PROCESS, not on disk. Every read goes through one seam, transcript_scope, because a pinned config dir moves where they land." vertex="1">
          <mxGeometry height="126" width="412" x="1414" y="628" as="geometry" />
        </mxCell>
        <mxCell id="d-grp4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#a34c27;fontStyle=1;" value="IN-REPO — ${repo}/.grove/" vertex="1">
          <mxGeometry height="16" width="440" x="1400" y="774" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f2f5f9;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="200" width="440" x="1400" y="796" as="geometry" />
        </mxCell>
        <mxCell id="d4-t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="config.json — committed project layer. A worktree sees only COMMITTED files, so shared config must be committed to be inherited.&#xa;config.local.json — gitignored machine overrides.&#xa;&#xa;phase/&lt;key&gt;.json — the task-phase report, WRITTEN BY THE AGENT at the path Grove publishes in GROVE_PHASE_FILE. Keyed per agent, because several can share one worktree.&#xa;&#xa;attachments/&lt;id&gt;/&lt;name&gt; — the one directory a host process and a containerized agent both see.&#xa;&#xa;The todo list is NOT stored here: it is read live from the agent&#39;s own task board." vertex="1">
          <mxGeometry height="182" width="412" x="1414" y="808" as="geometry" />
        </mxCell>
        <mxCell id="d-grp5" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#a34c27;fontStyle=1;" value="CONFIG + CREDENTIALS — ~/.config/grove/ (0600)" vertex="1">
          <mxGeometry height="16" width="440" x="1400" y="1006" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f2f5f9;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="128" width="440" x="1400" y="1026" as="geometry" />
        </mxCell>
        <mxCell id="d5-t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="config.json — the user cascade layer.&#xa;auth.json — pairing challenges and daemon sessions.&#xa;webapp-sessions.json — LIVE plaintext daemon bearers, written by the Next.js BFF, never read by the daemon.&#xa;hook-ingest.token, channel.token — same-host secrets.&#xa;claude-*-settings.json, *-mcp.json — the control files an agent is launched with.&#xa;*.env — operator credentials; config stores only the NAME." vertex="1">
          <mxGeometry height="110" width="412" x="1414" y="1036" as="geometry" />
        </mxCell>
        <mxCell id="d-grp6" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#a34c27;fontStyle=1;" value="EXTERNAL — already the source of truth" vertex="1">
          <mxGeometry height="16" width="440" x="1400" y="1164" as="geometry" />
        </mxCell>
