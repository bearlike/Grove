        </mxCell>
        <mxCell id="se5-b" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#3d4a58;" value="Managed .drawio writes, revision compare-and-swap." vertex="1">
          <mxGeometry height="36" width="170" x="938" y="890" as="geometry" />
        </mxCell>
        <mxCell id="se6" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#eef1f4;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="64" width="200" x="1140" y="862" as="geometry" />
        </mxCell>
        <mxCell id="se6-h" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#18202b;fontStyle=1;" value="mewbo.py  +  process.py" vertex="1">
