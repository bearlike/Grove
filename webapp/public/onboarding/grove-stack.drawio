        <mxCell id="c-client-b" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#3d4a58;" value="Transport-agnostic attach. Three transports on one Protocol: Local (spawns a daemon), Ssh (tunnels), Url (attaches to a running one). Once attached, tmux owns the UI." vertex="1">
          <mxGeometry height="64" width="280" x="71" y="452" as="geometry" />
        </mxCell>
        <mxCell id="c-daemon" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#fbeee6;strokeColor=#eec9ae;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="86" width="620" x="380" y="428" as="geometry" />
        </mxCell>
        <mxCell id="c-daemon-h" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#18202b;fontStyle=1;" value="Daemon  ·  src/grove/daemon/  ·  FastAPI, loopback 127.0.0.1:7421" vertex="1">
          <mxGeometry height="18" width="590" x="396" y="440" as="geometry" />
        </mxCell>
        <mxCell id="c-daemon-b" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#3d4a58;" value="One process serves every repo through RepoRegistry; responses are contract Views, never engine dataclasses. Loopback-only bind is load-bearing — it is why endpoint auth defers to the user&#39;s own SSH credentials. Runs blocking work off the loop." vertex="1">
          <mxGeometry height="52" width="600" x="396" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c-routes" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f2f5f9;strokeColor=#d3dce6;strokeWidth=1;" value="" vertex="1">
