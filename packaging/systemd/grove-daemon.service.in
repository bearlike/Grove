[Unit]
Description=Grove daemon (HTTP + tmux orchestration)
Documentation=https://github.com/bearlike/Grove
After=network.target

[Service]
Type=simple
ExecStart=@GROVE_BIN@ daemon serve --host @DAEMON_HOST@ --port @DAEMON_PORT@
# The daemon runs user-authored init scripts. systemd --user provides a bare
# PATH (rc files are never sourced), so pyenv/nvm/asdf-managed toolchains
# resolved to stale system binaries and init failed (issue #9). Rendered from
# the PATH of the shell that ran `make systemd` — re-run it after toolchain
# moves (e.g. an nvm default bump), or override: `DAEMON_PATH=... make systemd`.
Environment=PATH=@DAEMON_PATH@
Restart=on-failure
RestartSec=2
# stdout/stderr -> journalctl --user -u grove-daemon
StandardOutput=journal
StandardError=journal

[Install]
# Present so `systemctl --user enable grove-daemon` works when the user
# wants auto-start on login. Not enabled by `make systemd` alone — opt
# in with `make systemd-enable`.
WantedBy=default.target
