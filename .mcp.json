{
  "mcpServers": {
    "grove": {
      "command": "grove-mcp",
      "args": []
    },
    "grove-network": {
      "type": "http",
      "url": "http://host.docker.internal:7431/mcp",
      "headers": {
        "Authorization": "Bearer ${GROVE_MCP_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "tmux": {
      "command": "npx",
      "args": ["-y", "tmux-mcp"]
    },
    "openalex": {
      "type": "http",
      "url": "https://openalex.caseyjhand.com/mcp"
    },
    "wikidata": {
      "type": "http",
      "url": "https://wd-mcp.wmcloud.org/mcp/"
    },
    "huggingface": {
      "type": "http",
      "url": "https://hf.co/mcp"
    },
    "gitmcp": {
      "type": "http",
      "url": "https://gitmcp.io/docs"
    }
  }
}
